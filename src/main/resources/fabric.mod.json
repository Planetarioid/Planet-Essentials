{
  "schemaVersion": 1,
  "id": "planet_essentials",
  "version": "${version}",
  "name": "Space Client",
  "description": "A unified Minecraft client experience by Planet Studios, combining settings, HUD tools, diagnostics, and performance systems.",
  "authors": [
    "Planet Studios"
  ],
  "contact": {
    "homepage": "https://github.com/Planetarioid/Planet-Essentials",
    "sources": "https://github.com/Planetarioid/Planet-Essentials"
  },
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.planetstudios.essentials.PlanetEssentials"
    ],
    "client": [
      "com.planetstudios.essentials.client.PlanetEssentialsClient"
    ],
    "planet_essentials_api": [
      "com.planetstudios.essentials.integration.PlanetEssentialsApiImpl"
    ]
  },
  "mixins": [
    "planet_essentials.client.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.18.0",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": ">=0.141.6"
  },
  "suggests": {
    "planet_lib": ">=0.1.0-alpha.1"
  }
}
